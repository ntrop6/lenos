From f8d2f88bb7c9e5853e35d2ba89335cdcbade7340 Mon Sep 17 00:00:00 2001
From: lenOS <lenos@lenos.invalid>
Date: Mon, 21 Sep 2026 17:24:07 +0300
Subject: [PATCH 2/5] lenOS: integration makefile

Adds the lenOS product integration: build-time removal of camera/browser/
SIM toolkit/gallery/contacts/recorder/calendar (plus Lineage music and
updater and their overlays), boot animation replacement, the vendored
runtime (sysctl rc, network enforcement daemon) and the Cromite browser
hook. Contains no lenOS-identifying build strings.
---
 lenos.mk | 54 ++++++++++++++++++++++++++++++++++++++++++++++++++++++
 1 file changed, 54 insertions(+)
 create mode 100644 lenos.mk

diff --git a/lenos.mk b/lenos.mk
new file mode 100644
index 0000000..5b3e93a
--- /dev/null
+++ b/lenos.mk
@@ -0,0 +1,54 @@
+#
+# SPDX-FileCopyrightText: 2026 lenOS contributors
+# SPDX-License-Identifier: MIT
+#
+
+# lenOS product integration. Everything here is additive except the two
+# explicit removal filters. Files referenced from vendor/lenos are copied
+# into the tree by the lenOS integrator before the build. Nothing in this
+# file writes lenOS-identifying strings into the system image.
+
+# Cromite browser (presigned prebuilt, sha256-pinned; see
+# tools/fetch-cromite.sh). Skipped with a warning when the APK is absent so
+# a build never silently ships without a browser decision.
+$(call inherit-product-if-exists, vendor/lenos/cromite.mk)
+
+# Build-time removal of stock apps (the user's list): camera, browser, SIM
+# toolkit, gallery, contacts, recorder, calendar, plus the Lineage music
+# app and updater. Aperture RRO overlays go with the camera app they
+# belong to. The remaining Lineage apps stay uninstallable at runtime from
+# the lenOS panel in Settings (pm uninstall --user 0).
+LENOS_REMOVED_PACKAGES := \
+    Aperture \
+    AsteroidsApertureOverlay \
+    AsteroidsApertureDevOverlay \
+    Gallery2 \
+    Jelly \
+    Recorder \
+    Stk \
+    Contacts \
+    Etar \
+    Eleven \
+    Updater
+
+PRODUCT_PACKAGES := $(filter-out $(LENOS_REMOVED_PACKAGES),$(PRODUCT_PACKAGES))
+
+# lenOS boot animation replaces the LineageOS one when the integrator has
+# generated it (tools/make-bootanimation.py).
+ifneq (,$(wildcard vendor/lenos/bootanimation/bootanimation.zip))
+PRODUCT_COPY_FILES := $(filter-out %bootanimation.zip,$(PRODUCT_COPY_FILES))
+PRODUCT_COPY_FILES += \
+    vendor/lenos/bootanimation/bootanimation.zip:$(TARGET_COPY_OUT_SYSTEM)/media/bootanimation.zip
+endif
+
+# lenOS runtime: sysctl hardening and the network enforcement daemon. The
+# daemon's toggles live in Settings.Global, written from the lenOS panel in
+# the Settings app.
+PRODUCT_COPY_FILES += \
+    vendor/lenos/init/lenos_sysctl.rc:$(TARGET_COPY_OUT_SYSTEM_EXT)/etc/init/lenos_sysctl.rc \
+    vendor/lenos/init/lenos_net.rc:$(TARGET_COPY_OUT_SYSTEM_EXT)/etc/init/lenos_net.rc \
+    vendor/lenos/bin/lenos-netd:$(TARGET_COPY_OUT_SYSTEM_EXT)/bin/lenos-netd
+
+# The kernel hardening fragment referenced by BoardConfig
+# (vendor/lenos_hardening.config) is written into the kernel tree by the
+# lenOS integrator; the profile (standard/full/strict) selects its content.
-- 
