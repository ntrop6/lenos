From a1c0e07d08f417c8d59baa60f3eebf83a23d51a6 Mon Sep 17 00:00:00 2001
From: lenOS <lenos@lenos.invalid>
Date: Mon, 21 Sep 2026 18:51:59 +0300
Subject: [PATCH 2/5] lenOS: integration makefile

Adds the lenOS product integration: the removal list (filtered at the tail
of lenos_asteroids.mk because the Lineage inherits add these packages
after this file is parsed), boot animation copies to /product/media under
both candidate names, the vendored runtime (sysctl rc, network enforcement
daemon), and the Cromite browser hook. Contains no lenOS-identifying
build strings.
---
 lenos.mk | 53 +++++++++++++++++++++++++++++++++++++++++++++++++++++
 1 file changed, 53 insertions(+)
 create mode 100644 lenos.mk

diff --git a/lenos.mk b/lenos.mk
new file mode 100644
index 0000000..2411d51
--- /dev/null
+++ b/lenos.mk
@@ -0,0 +1,53 @@
+#
+# SPDX-FileCopyrightText: 2026 lenOS contributors
+# SPDX-License-Identifier: MIT
+#
+
+# lenOS product integration. Everything here is additive except the app
+# removal performed at the tail of lenos_asteroids.mk (it must run after
+# every inherit). Files referenced from vendor/lenos are copied into the
+# tree by the lenOS integrator before the build. Nothing in this file
+# writes lenOS-identifying strings into the system image.
+
+# Cromite browser (presigned prebuilt, sha256-pinned; see
+# tools/fetch-cromite.sh). Skipped with a warning when the APK is absent so
+# a build never silently ships without a browser decision.
+$(call inherit-product-if-exists, vendor/lenos/cromite.mk)
+
+# The build-time removal list. Filtering happens at the tail of
+# lenos_asteroids.mk (GNU-make parse order: the Lineage inherits add these
+# packages after this file is parsed).
+LENOS_REMOVED_PACKAGES := \
+    Aperture \
+    AsteroidsApertureOverlay \
+    AsteroidsApertureDevOverlay \
+    Gallery2 \
+    Jelly \
+    Recorder \
+    Stk \
+    Contacts \
+    Etar \
+    Eleven \
+    Updater
+
+# lenOS boot animation: installed at /product/media (higher probe priority
+# than /system/media; see frameworks BootAnimation.cpp) under both the
+# regular and the ro.boot.theme-selected dark name. The Lineage modules are
+# dropped at the tail of lenos_asteroids.mk.
+ifneq (,$(wildcard vendor/lenos/bootanimation/bootanimation.zip))
+PRODUCT_COPY_FILES += \
+    vendor/lenos/bootanimation/bootanimation.zip:$(TARGET_COPY_OUT_PRODUCT)/media/bootanimation.zip \
+    vendor/lenos/bootanimation/bootanimation.zip:$(TARGET_COPY_OUT_PRODUCT)/media/bootanimation-dark.zip
+endif
+
+# lenOS runtime: sysctl hardening and the network enforcement daemon. The
+# daemon's toggles live in Settings.Global, written from the lenOS panel in
+# the Settings app.
+PRODUCT_COPY_FILES += \
+    vendor/lenos/init/lenos_sysctl.rc:$(TARGET_COPY_OUT_SYSTEM_EXT)/etc/init/lenos_sysctl.rc \
+    vendor/lenos/init/lenos_net.rc:$(TARGET_COPY_OUT_SYSTEM_EXT)/etc/init/lenos_net.rc \
+    vendor/lenos/bin/lenos-netd:$(TARGET_COPY_OUT_SYSTEM_EXT)/bin/lenos-netd
+
+# The kernel hardening fragment referenced by BoardConfig
+# (vendor/lenos_hardening.config) is written into the kernel tree by the
+# lenOS integrator; the profile (standard/full/strict) selects its content.
-- 
