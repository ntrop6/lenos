# lenOS runtime hardening. Missing sysctls log an init error but do not stop boot.
# Deliberately does NOT disable kernel modules, namespaces, tracing, or io_uring.
on post-fs
    write /proc/sys/kernel/kptr_restrict 2
    write /proc/sys/kernel/dmesg_restrict 1
    write /proc/sys/kernel/perf_event_paranoid 3
    write /proc/sys/kernel/unprivileged_bpf_disabled 1
    write /proc/sys/kernel/kexec_load_disabled 1
    write /proc/sys/kernel/randomize_va_space 2
    write /proc/sys/vm/unprivileged_userfaultfd 0
    write /proc/sys/fs/protected_symlinks 1
    write /proc/sys/fs/protected_hardlinks 1
    write /proc/sys/fs/protected_fifos 2
    write /proc/sys/fs/protected_regular 2
    write /proc/sys/fs/suid_dumpable 0
    write /proc/sys/net/core/bpf_jit_harden 2
    write /proc/sys/dev/tty/legacy_tiocsti 0
    write /proc/sys/dev/tty/ldisc_autoload 0
