diff --git a/src/com/android/settings/lenos/LenosAppsFragment.java b/src/com/android/settings/lenos/LenosAppsFragment.java
new file mode 100644
index 0000000..3597218
--- /dev/null
+++ b/src/com/android/settings/lenos/LenosAppsFragment.java
@@ -0,0 +1,137 @@
+/*
+ * System app removal for user 0. Lists installed system packages except a
+ * critical denylist and uninstalls them for the current user through the
+ * pm command (the Settings app already declares DELETE_PACKAGES and runs
+ * as the system UID). The APK stays on the read-only partition; an OTA or
+ * factory reset restores it.
+ */
+package com.android.settings.lenos;
+
+import android.app.AlertDialog;
+import android.content.pm.ApplicationInfo;
+import android.content.pm.PackageManager;
+import android.os.Bundle;
+import android.widget.Toast;
+
+import androidx.preference.Preference;
+import androidx.preference.PreferenceScreen;
+
+import com.android.settings.R;
+import com.android.settings.SettingsPreferenceFragment;
+import com.android.settingslib.core.instrumentation.Instrumentable;
+
+import java.io.BufferedReader;
+import java.io.InputStreamReader;
+import java.util.ArrayList;
+import java.util.Arrays;
+import java.util.Collections;
+import java.util.HashSet;
+import java.util.List;
+import java.util.Set;
+
+public class LenosAppsFragment extends SettingsPreferenceFragment {
+
+    private static final Set<String> DENY = new HashSet<>(Arrays.asList(
+            "android",
+            "com.android.settings",
+            "com.android.systemui",
+            "com.android.launcher3",
+            "com.android.phone",
+            "com.android.server.telecom",
+            "com.android.inputmethod.latin",
+            "com.android.providers.telephony",
+            "com.android.providers.settings",
+            "com.android.providers.media",
+            "com.android.keychain",
+            "com.android.deskclock"
+    ));
+
+    public String getLogTag() {
+        return "LenosApps";
+    }
+
+    @Override
+    public int getMetricsCategory() {
+        return Instrumentable.METRICS_CATEGORY_UNKNOWN;
+    }
+
+    @Override
+    public void onCreatePreferences(Bundle savedInstanceState, String rootKey) {
+        rebuild();
+    }
+
+    private void rebuild() {
+        final PackageManager pm = getContext().getPackageManager();
+        final PreferenceScreen screen =
+                getPreferenceManager().createPreferenceScreen(getContext());
+        final List<String> rows = new ArrayList<>();
+        for (ApplicationInfo ai : pm.getInstalledPackages(PackageManager.GET_META_DATA)) {
+            if ((ai.flags & ApplicationInfo.FLAG_SYSTEM) == 0
+                    || DENY.contains(ai.packageName)) {
+                continue;
+            }
+            final CharSequence label = pm.getApplicationLabel(ai);
+            rows.add(ai.packageName + "|" + (label != null ? label : ai.packageName));
+        }
+        Collections.sort(rows, String.CASE_INSENSITIVE_ORDER);
+        if (rows.isEmpty()) {
+            final Preference none = new Preference(getContext());
+            none.setKey("lenos_none_removable");
+            none.setTitle(R.string.lenos_none_removable);
+            none.setSelectable(false);
+            screen.addPreference(none);
+        }
+        for (String row : rows) {
+            final int sep = row.indexOf('|');
+            final String pkg = row.substring(0, sep);
+            final String label = row.substring(sep + 1);
+            final Preference p = new Preference(getContext());
+            p.setKey("lenos_app_" + pkg);
+            p.setTitle(label);
+            p.setSummary(pkg);
+            p.setOnPreferenceClickListener(preference -> {
+                confirmUninstall(pkg);
+                return true;
+            });
+            screen.addPreference(p);
+        }
+        setPreferenceScreen(screen);
+    }
+
+    private void confirmUninstall(final String pkg) {
+        new AlertDialog.Builder(getContext())
+                .setTitle(String.format(getString(R.string.lenos_remove_confirm_title), pkg))
+                .setMessage(R.string.lenos_remove_confirm_text)
+                .setPositiveButton(R.string.lenos_remove_action,
+                        (dialog, which) -> uninstall(pkg))
+                .setNegativeButton(android.R.string.cancel, null)
+                .show();
+    }
+
+    private void uninstall(String pkg) {
+        String result;
+        try {
+            final Process p = new ProcessBuilder(
+                    "pm", "uninstall", "--user", "0", pkg)
+                    .redirectErrorStream(true).start();
+            final StringBuilder out = new StringBuilder();
+            try (BufferedReader r = new BufferedReader(
+                    new InputStreamReader(p.getInputStream()))) {
+                String line;
+                while ((line = r.readLine()) != null) {
+                    out.append(line).append('\n');
+                }
+            }
+            final int rc = p.waitFor();
+            result = rc == 0
+                    ? String.format(getString(R.string.lenos_remove_done), pkg)
+                    : String.format(getString(R.string.lenos_remove_failed),
+                            out.toString().trim());
+        } catch (Exception e) {
+            result = String.format(getString(R.string.lenos_remove_failed),
+                    e.getClass().getSimpleName());
+        }
+        Toast.makeText(getContext(), result, Toast.LENGTH_LONG).show();
+        rebuild();
+    }
+}
diff --git a/src/com/android/settings/lenos/LenosSecurityFragment.java b/src/com/android/settings/lenos/LenosSecurityFragment.java
new file mode 100644
index 0000000..5fe32e7
--- /dev/null
+++ b/src/com/android/settings/lenos/LenosSecurityFragment.java
@@ -0,0 +1,196 @@
+/*
+ * lenOS security panel. Writes the enforcement state into Settings.Global;
+ * the lenos-netd daemon (shipped in system_ext) applies it kernel-side.
+ * Keys: lenos_killswitch, lenos_ntp_shield, lenos_strict_firewall,
+ * lenos_vpn_uids, lenos_captive_portal. The LTE-only radio switch talks to
+ * TelephonyManager directly (MODIFY_PHONE_STATE is declared by the Settings
+ * app and granted to the system UID).
+ */
+package com.android.settings.lenos;
+
+import android.content.Context;
+import android.os.Bundle;
+import android.provider.Settings;
+import android.telephony.TelephonyManager;
+import android.widget.Toast;
+
+import androidx.preference.EditTextPreference;
+import androidx.preference.Preference;
+import androidx.preference.SwitchPreferenceCompat;
+
+import com.android.settings.R;
+import com.android.settings.SettingsPreferenceFragment;
+import com.android.settings.core.SubSettingLauncher;
+import com.android.settingslib.core.instrumentation.Instrumentable;
+
+import java.util.regex.Pattern;
+
+public class LenosSecurityFragment extends SettingsPreferenceFragment {
+
+    private static final String KEY_KILLSWITCH = "lenos_killswitch";
+    private static final String KEY_NTP_SHIELD = "lenos_ntp_shield";
+    private static final String KEY_STRICT = "lenos_strict_firewall";
+    private static final String KEY_VPN_UIDS = "lenos_vpn_uids";
+    private static final String KEY_CAPTIVE = "lenos_captive_portal";
+    private static final String KEY_LTE_ONLY = "lenos_lte_only";
+    private static final String KEY_LTE_SAVED = "lenos_lte_saved";
+    private static final Pattern UID_LIST = Pattern.compile("[0-9]*(,[0-9]+)*");
+
+    private static final long LTE_NR_ONLY =
+            TelephonyManager.NETWORK_TYPE_BITMASK_LTE
+            | TelephonyManager.NETWORK_TYPE_BITMASK_NR;
+
+    // Every real radio type in the pinned TelephonyManager (IWLAN and
+    // UNKNOWN excluded; NETWORK_TYPE_BITMASK_1xRTT is spelled with a
+    // lowercase x).
+    private static final long ALL_NETWORK_TYPES =
+            TelephonyManager.NETWORK_TYPE_BITMASK_GSM
+            | TelephonyManager.NETWORK_TYPE_BITMASK_GPRS
+            | TelephonyManager.NETWORK_TYPE_BITMASK_EDGE
+            | TelephonyManager.NETWORK_TYPE_BITMASK_CDMA
+            | TelephonyManager.NETWORK_TYPE_BITMASK_1xRTT
+            | TelephonyManager.NETWORK_TYPE_BITMASK_IDEN
+            | TelephonyManager.NETWORK_TYPE_BITMASK_EVDO_0
+            | TelephonyManager.NETWORK_TYPE_BITMASK_EVDO_A
+            | TelephonyManager.NETWORK_TYPE_BITMASK_EVDO_B
+            | TelephonyManager.NETWORK_TYPE_BITMASK_UMTS
+            | TelephonyManager.NETWORK_TYPE_BITMASK_TD_SCDMA
+            | TelephonyManager.NETWORK_TYPE_BITMASK_HSDPA
+            | TelephonyManager.NETWORK_TYPE_BITMASK_HSUPA
+            | TelephonyManager.NETWORK_TYPE_BITMASK_HSPAP
+            | TelephonyManager.NETWORK_TYPE_BITMASK_HSPA
+            | TelephonyManager.NETWORK_TYPE_BITMASK_EHRPD
+            | TelephonyManager.NETWORK_TYPE_BITMASK_LTE
+            | TelephonyManager.NETWORK_TYPE_BITMASK_LTE_CA
+            | TelephonyManager.NETWORK_TYPE_BITMASK_NR;
+
+    public String getLogTag() {
+        return "LenosSecurity";
+    }
+
+    @Override
+    public int getMetricsCategory() {
+        return Instrumentable.METRICS_CATEGORY_UNKNOWN;
+    }
+
+    @Override
+    public void onCreatePreferences(Bundle savedInstanceState, String rootKey) {
+        addPreferencesFromResource(R.xml.lenos_security_settings);
+
+        final Context context = getContext();
+
+        final SwitchPreferenceCompat kill =
+                (SwitchPreferenceCompat) findPreference(KEY_KILLSWITCH);
+        kill.setChecked(Settings.Global.getInt(
+                context.getContentResolver(), KEY_KILLSWITCH, 1) != 0);
+        kill.setOnPreferenceChangeListener((preference, newValue) ->
+                putGlobal(KEY_KILLSWITCH, (Boolean) newValue ? "1" : "0"));
+
+        final SwitchPreferenceCompat ntp =
+                (SwitchPreferenceCompat) findPreference(KEY_NTP_SHIELD);
+        ntp.setChecked(Settings.Global.getInt(
+                context.getContentResolver(), KEY_NTP_SHIELD, 1) != 0);
+        ntp.setOnPreferenceChangeListener((preference, newValue) ->
+                putGlobal(KEY_NTP_SHIELD, (Boolean) newValue ? "1" : "0"));
+
+        final SwitchPreferenceCompat strict =
+                (SwitchPreferenceCompat) findPreference(KEY_STRICT);
+        strict.setChecked(Settings.Global.getInt(
+                context.getContentResolver(), KEY_STRICT, 0) != 0);
+        strict.setOnPreferenceChangeListener((preference, newValue) ->
+                putGlobal(KEY_STRICT, (Boolean) newValue ? "1" : "0"));
+
+        final EditTextPreference uids = (EditTextPreference) findPreference(KEY_VPN_UIDS);
+        final String current = Settings.Global.getString(
+                context.getContentResolver(), KEY_VPN_UIDS);
+        if (current != null) {
+            uids.setText(current);
+        }
+        uids.setOnPreferenceChangeListener((preference, newValue) -> {
+            final String value = String.valueOf(newValue).trim();
+            if (!UID_LIST.matcher(value).matches()) {
+                Toast.makeText(context, R.string.lenos_invalid_uids,
+                        Toast.LENGTH_LONG).show();
+                return false;
+            }
+            return putGlobal(KEY_VPN_UIDS, value);
+        });
+
+        // captive_portal_mode per Settings.Global javadoc: 0 = IGNORE (no
+        // detection, no probes), 1 = PROMPT (stock default; probes go to
+        // Google), 2 = AVOID (disconnect and blacklist portal networks).
+        // The switch is ON for detection (1), OFF for none (0); the AOSP
+        // default when the key is unset is PROMPT, so unset reads as ON.
+        final SwitchPreferenceCompat captive =
+                (SwitchPreferenceCompat) findPreference(KEY_CAPTIVE);
+        captive.setChecked(Settings.Global.getInt(
+                context.getContentResolver(), "captive_portal_mode",
+                Settings.Global.CAPTIVE_PORTAL_MODE_PROMPT)
+                != Settings.Global.CAPTIVE_PORTAL_MODE_IGNORE);
+        captive.setOnPreferenceChangeListener((preference, newValue) ->
+                putGlobal("captive_portal_mode", (Boolean) newValue
+                        ? String.valueOf(Settings.Global.CAPTIVE_PORTAL_MODE_PROMPT)
+                        : String.valueOf(Settings.Global.CAPTIVE_PORTAL_MODE_IGNORE)));
+
+        final SwitchPreferenceCompat lte =
+                (SwitchPreferenceCompat) findPreference(KEY_LTE_ONLY);
+        bindLteOnly(context, lte);
+
+        final Preference remove = findPreference("lenos_remove_apps");
+        remove.setOnPreferenceClickListener(preference -> {
+            new SubSettingLauncher(context)
+                    .setDestination(LenosAppsFragment.class.getName())
+                    .setSourceMetricsCategory(getMetricsCategory())
+                    .launch();
+            return true;
+        });
+    }
+
+    private void bindLteOnly(Context context, SwitchPreferenceCompat lte) {
+        boolean on = Settings.Global.getInt(
+                context.getContentResolver(), KEY_LTE_ONLY, 0) != 0;
+        lte.setChecked(on);
+        lte.setOnPreferenceChangeListener((preference, newValue) -> {
+            final TelephonyManager tm = context.getSystemService(TelephonyManager.class);
+            try {
+                if ((Boolean) newValue) {
+                    // Remember the unrestricted mask so switching back
+                    // restores exactly what the carrier config allowed.
+                    final long saved = tm.getAllowedNetworkTypesForReason(
+                            TelephonyManager.ALLOWED_NETWORK_TYPES_REASON_USER);
+                    putGlobal(KEY_LTE_SAVED, String.valueOf(saved));
+                    tm.setAllowedNetworkTypesForReason(
+                            TelephonyManager.ALLOWED_NETWORK_TYPES_REASON_USER,
+                            LTE_NR_ONLY);
+                } else {
+                    long restore;
+                    try {
+                        restore = Long.parseLong(Settings.Global.getString(
+                                context.getContentResolver(), KEY_LTE_SAVED));
+                    } catch (RuntimeException notSet) {
+                        restore = ALL_NETWORK_TYPES;
+                    }
+                    tm.setAllowedNetworkTypesForReason(
+                            TelephonyManager.ALLOWED_NETWORK_TYPES_REASON_USER,
+                            restore);
+                }
+                return true;
+            } catch (RuntimeException e) {
+                Toast.makeText(context, "Radio change failed: " + e.getMessage(),
+                        Toast.LENGTH_LONG).show();
+                return false;
+            }
+        });
+    }
+
+    private boolean putGlobal(String key, String value) {
+        try {
+            Settings.Global.putString(getContext().getContentResolver(), key, value);
+            return true;
+        } catch (SecurityException e) {
+            Toast.makeText(getContext(), "Write failed: " + e.getMessage(),
+                    Toast.LENGTH_LONG).show();
+            return false;
+        }
+    }
+}
