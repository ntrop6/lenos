+<?xml version="1.0" encoding="utf-8"?>
+<!-- lenOS strings. In-UI only: no lenOS strings are written to build props. -->
+<resources>
+    <string name="lenos_title">lenOS security</string>
+    <string name="lenos_summary">Network shield and device hygiene</string>
+    <string name="lenos_network_category">Network shield</string>
+    <string name="lenos_dns_enforce">Block plaintext DNS</string>
+    <string name="lenos_dns_enforce_summary">Rejects UDP and TCP port 53 outside VPN tunnels at all times. DoT providers and VPN-tunnel DNS keep working.</string>
+    <string name="lenos_dns_time_summary">Also rejects time sync (UDP 123) outside VPN tunnels, keeping clock-disclosure off the open network.</string>
+    <string name="lenos_strict_firewall">Strict firewall</string>
+    <string name="lenos_strict_firewall_summary">Default-drop all output except loopback, established connections, tun interfaces and the allowed VPN UIDs. Requires an always-on VPN; daily drivers should use the platform lockdown instead.</string>
+    <string name="lenos_vpn_uids">Allowed VPN UIDs</string>
+    <string name="lenos_vpn_uids_summary">Comma-separated UIDs allowed outside tun interfaces in strict mode (the VPN app transport UIDs)</string>
+    <string name="lenos_radio_category">Radio</string>
+    <string name="lenos_lte_only">LTE-only radio</string>
+    <string name="lenos_lte_only_summary">Drops 2G and 3G radio code paths (the classic IMSI-catcher and downgrade surface) and keeps LTE/5G data. Turn off only when a legacy network is essential.</string>
+    <string name="lenos_captive_portal">Captive portal detection</string>
+    <string name="lenos_captive_portal_summary">Off by default: the device sends no connectivity probes and does not auto-open hotel or airport login pages. When on, probes go to Google endpoints (stock behavior).</string>
+    <string name="lenos_apps_category">Applications</string>
+    <string name="lenos_remove_apps">Remove system apps</string>
+    <string name="lenos_remove_apps_summary">Uninstall non-critical system apps for this user</string>
+    <string name="lenos_about_category">About</string>
+    <string name="lenos_version_title">lenOS version</string>
+    <string name="lenos_version_value">1.0</string>
+    <string name="lenos_remove_confirm_title">Remove %s?</string>
+    <string name="lenos_remove_confirm_text">Uninstalls for this user (user 0). An OTA or factory reset restores the app.</string>
+    <string name="lenos_remove_action">Remove</string>
+    <string name="lenos_remove_done">Removed %s</string>
+    <string name="lenos_remove_failed">Removal failed: %s</string>
+    <string name="lenos_none_removable">No removable system apps</string>
+    <string name="lenos_invalid_uids">Invalid list: use comma-separated numeric UIDs</string>
+</resources>
