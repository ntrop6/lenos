+package com.android.server.policy.keyguard;
+
+import android.content.Context;
+import android.os.SystemProperties;
+import android.provider.Settings;
+import android.util.Slog;
+
+import java.util.concurrent.TimeUnit;
+
+/** Low-level inactivity reboot bridge. The actual alarm is owned by init. @hide */
+final class AutoReboot {
+    private static final String TAG = AutoReboot.class.getSimpleName();
+    static final String SETTING = "lenos_auto_reboot_timeout_ms";
+    static final int DEFAULT_TIMEOUT_MILLIS = (int) TimeUnit.HOURS.toMillis(18);
+
+    // Writes to this system property are intercepted by init and never persisted.
+    private static final String SYS_PROP = "sys.auto_reboot_ctl";
+
+    private AutoReboot() {}
+
+    private static void sendControl(String value) {
+        try {
+            SystemProperties.set(SYS_PROP, value);
+        } catch (RuntimeException e) {
+            // A missing init timer or policy mismatch must not crash system_server and cause a
+            // framework restart loop. Physical validation still treats this as a failed feature.
+            Slog.e(TAG, "Unable to update init-owned automatic BFU timer", e);
+        }
+    }
+
+    // Invoked when keyguard becomes active and after a successful dismissal.
+    static void onKeyguardShowingStateChanged(Context context, boolean showing, int userId) {
+        Slog.d(TAG, "keyguard state changed: showing=" + showing + ", userId=" + userId);
+
+        if (!showing) {
+            sendControl("on_device_unlocked");
+            return;
+        }
+
+        final int timeoutMillis = Settings.Global.getInt(context.getContentResolver(),
+                SETTING, DEFAULT_TIMEOUT_MILLIS);
+        final int timeoutSeconds = timeoutMillis / 1000;
+        if (timeoutSeconds > 0) {
+            sendControl(Integer.toString(timeoutSeconds));
+        }
+        Slog.d(TAG, "timeoutSeconds=" + timeoutSeconds);
+    }
+}
