+    private boolean applyOverlayChoice(String[] values, String[] packages,
+            String value, int successMessage, int failureMessage) {
+        try {
+            OverlayManager manager = getContext().getSystemService(OverlayManager.class);
+            if (manager == null) {
+                throw new IllegalStateException("OverlayManager unavailable");
+            }
+            int selected = indexOf(values, value);
+            if (selected < 0) {
+                return false;
+            }
+            if (selected == enabledOption(packages, 0)) {
+                // The first layout pass can report the already-current
+                // selection; it must not toggle an overlay.
+                return true;
+            }
+            Set<String> installed = installedPackages(manager, SYSTEMUI_PACKAGE);
+            for (int i = 0; i < packages.length; i++) {
+                String pkg = packages[i];
+                if (pkg == null || !installed.contains(pkg)) {
+                    continue;
+                }
+                manager.setEnabled(pkg, i == selected, Process.myUserHandle());
+            }
+            toast(successMessage);
+            return true;
+        } catch (Throwable t) {
+            toast(getString(failureMessage, messageOf(t)));
+            return false;
+        }
+    }
+
+    private void setOverlayListValue(String key, String[] values, String[] packages) {
+        ListPreference preference = findPreference(key);
+        if (preference == null) {
+            return;
+        }
+        preference.setValue(currentOverlayValue(values, packages));
+        updateListSummary(preference);
+    }
+
+    private String currentOverlayValue(String[] values, String[] packages) {
+        int index = enabledOption(packages, 0);
+        return index >= 0 && index < values.length ? values[index] : values[0];
+    }
+
+    private int enabledOption(String[] packages, int defaultIndex) {
+        try {
+            OverlayManager manager = getContext().getSystemService(OverlayManager.class);
+            if (manager == null) {
+                return defaultIndex;
+            }
+            Set<String> enabled = new HashSet<>();
+            for (OverlayInfo info : manager.getOverlayInfosForTarget(
+                    SYSTEMUI_PACKAGE, Process.myUserHandle())) {
+                if (info.isEnabled()) {
+                    enabled.add(info.getPackageName());
+                }
+            }
+            for (int i = 0; i < packages.length; i++) {
+                if (packages[i] != null && enabled.contains(packages[i])) {
+                    return i;
+                }
+            }
+        } catch (Throwable ignored) {
+            // Keep the default visible if the overlay service is unavailable.
+        }
+        return defaultIndex;
+    }
+
+    private static Set<String> installedPackages(OverlayManager manager,
+            String targetPackage) {
+        Set<String> installed = new HashSet<>();
+        for (OverlayInfo info : manager.getOverlayInfosForTarget(
+                targetPackage, Process.myUserHandle())) {
+            installed.add(info.getPackageName());
+        }
+        return installed;
+    }
