+    private static String sysProp(String key, String fallback) {
+        try {
+            Class<?> clazz = Class.forName("android.os.SystemProperties");
+            return (String) clazz.getMethod("get", String.class, String.class)
+                    .invoke(null, key, fallback);
+        } catch (Exception e) {
+            return fallback;
+        }
+    }
