+    /**
+     * Reads the launcher's grid choices off the UI thread. The provider may
+     * start the launcher process, so a synchronous query could block the panel
+     * on first open.
+     */
+    private void refreshLauncherGrid() {
+        ListPreference preference = findPreference(KEY_LAUNCHER_GRID);
+        if (preference == null) {
+            return;
+        }
+        preference.setEnabled(false);
+        final Context context = requireContext().getApplicationContext();
+        final Activity activity = getActivity();
+        if (activity == null) {
+            return;
+        }
+        final int request = ++mLauncherGridRequest;
+        new Thread(() -> {
+            List<String> names = new ArrayList<>();
+            List<String> labels = new ArrayList<>();
+            int selected = -1;
+            try (Cursor cursor = context.getContentResolver().query(
+                    launcherProviderUri(LAUNCHER_LIST_OPTIONS),
+                    new String[]{"name", "grid_title", "rows", "cols",
+                            "is_default"},
+                    null, null, null)) {
+                if (cursor != null) {
+                    int nameIndex = cursor.getColumnIndexOrThrow("name");
+                    int titleIndex = cursor.getColumnIndex("grid_title");
+                    int rowsIndex = cursor.getColumnIndexOrThrow("rows");
+                    int columnsIndex = cursor.getColumnIndexOrThrow("cols");
+                    int defaultIndex =
+                            cursor.getColumnIndexOrThrow("is_default");
+                    while (cursor.moveToNext()) {
+                        String name = cursor.getString(nameIndex);
+                        if (name == null || name.isEmpty()) {
+                            continue;
+                        }
+                        String title = titleIndex >= 0
+                                ? cursor.getString(titleIndex) : null;
+                        int rows = cursor.getInt(rowsIndex);
+                        int columns = cursor.getInt(columnsIndex);
+                        boolean current = cursor.getInt(defaultIndex) != 0;
+                        names.add(name);
+                        labels.add(launcherGridLabel(title, columns, rows));
+                        if (current) {
+                            selected = names.size() - 1;
+                        }
+                    }
+                }
+            } catch (Throwable ignored) {
+                // A missing provider, a denied permission or a launcher
+                // without grid support all fall back to the settings entry.
+            }
+            final List<String> resultNames = names;
+            final List<String> resultLabels = labels;
+            final int resultSelected = selected;
+            activity.runOnUiThread(() -> {
+                if (!isAdded() || request != mLauncherGridRequest) {
+                    return;
+                }
+                showLauncherGrid(resultNames, resultLabels, resultSelected);
+            });
+        }, "lenos-launcher-grid-query").start();
+    }
+
+    private void showLauncherGrid(List<String> names, List<String> labels,
+            int selected) {
+        ListPreference preference = findPreference(KEY_LAUNCHER_GRID);
+        if (preference == null) {
+            return;
+        }
+        mLauncherGridNames.clear();
+        mLauncherGridNames.addAll(names);
+        if (names.isEmpty()) {
+            preference.setEntries(new CharSequence[]{
+                    getString(R.string.lenos_launcher_unavailable)});
+            preference.setEntryValues(new CharSequence[]{""});
+            preference.setValue("");
+            preference.setSummary(R.string.lenos_launcher_unavailable);
+            preference.setEnabled(false);
+            mLauncherGridCurrent = null;
+            return;
+        }
+        preference.setEntries(labels.toArray(new CharSequence[0]));
+        preference.setEntryValues(names.toArray(new CharSequence[0]));
+        int shown = selected >= 0 && selected < names.size() ? selected : 0;
+        preference.setValue(names.get(shown));
+        preference.setSummary(labels.get(shown));
+        preference.setEnabled(true);
+        // Treat the visible option as current so the initial callback cannot
+        // write a grid the user did not choose.
+        mLauncherGridCurrent = names.get(shown);
+    }
+
+    private void applyLauncherGrid(String name) {
+        ListPreference preference = findPreference(KEY_LAUNCHER_GRID);
+        if (preference != null) {
+            preference.setEnabled(false);
+        }
+        final Context context = requireContext().getApplicationContext();
+        final Activity activity = getActivity();
+        if (activity == null) {
+            return;
+        }
+        new Thread(() -> {
+            int updated = 0;
+            String failure = null;
+            try {
+                ContentValues values = new ContentValues();
+                values.put("name", name);
+                updated = context.getContentResolver().update(
+                        launcherProviderUri(LAUNCHER_DEFAULT_GRID), values,
+                        null, null);
+            } catch (Throwable t) {
+                failure = t.getMessage();
+            }
+            final int result = updated;
+            final String message = failure;
+            activity.runOnUiThread(() -> {
+                if (!isAdded()) {
+                    return;
+                }
+                if (result > 0) {
+                    mLauncherGridCurrent = name;
+                    toast(R.string.lenos_toast_launcher_grid_updated);
+                } else {
+                    toast(getString(R.string.lenos_toast_launcher_grid_failed,
+                            message == null ? "launcher rejected the change" : message));
+                }
+                refreshLauncherGrid();
+            });
+        }, "lenos-launcher-grid-apply").start();
+    }
+
+    private static String launcherGridLabel(String title, int columns, int rows) {
+        String size = columns + " \u00d7 " + rows;
+        if (title == null || title.trim().isEmpty()) {
+            return size;
+        }
+        return title.trim();
+    }
