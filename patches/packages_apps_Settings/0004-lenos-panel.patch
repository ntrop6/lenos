+        if (wifi != null) {
+            wifi.setOnPreferenceClickListener(p -> {
+                tryStartActivity(new Intent(Settings.ACTION_WIFI_SETTINGS));
+                return true;
+            });
+        }
+        Preference network = findPreference(KEY_APP_NETWORK);
+        if (network != null) {
+            network.setOnPreferenceClickListener(p -> {
+                tryStartActivity(new Intent(Settings.ACTION_DATA_USAGE_SETTINGS));
+                return true;
+            });
+        }
+        Preference about = findPreference(KEY_ABOUT);
+        if (about != null) {
+            about.setSummary(getString(R.string.lenos_about_summary,
+                    sysProp("ro.lenos.version", "?")));
+        }
+    }
+
+    private void openStatusBarSettings() {
+        Intent intent = new Intent(STATUS_BAR_ACTION);
+        intent.addCategory(Intent.CATEGORY_DEFAULT);
+        if (tryStartActivity(intent)) {
+            return;
+        }
+        if (tryStartActivity(new Intent(Settings.ACTION_DISPLAY_SETTINGS))) {
+            return;
+        }
+        toast(R.string.lenos_toast_status_bar_unavailable);
+    }
+
+    private void openLockScreenSettings() {
+        if (tryStartActivity(new Intent(Settings.ACTION_LOCKSCREEN_SETTINGS))) {
+            return;
+        }
+        if (tryStartActivity(new Intent(Settings.ACTION_SECURITY_SETTINGS))) {
+            return;
+        }
+        toast(R.string.lenos_toast_lockscreen_unavailable);
+    }
+
+    private boolean tryStartActivity(Intent intent) {
+        try {
+            startActivity(intent);
+            return true;
+        } catch (ActivityNotFoundException | SecurityException e) {
+            return false;
+        }
+    }
+
