+    private void refreshSecurityStatus() {
+        Preference preference = findPreference(KEY_SECURITY_STATUS);
+        if (preference == null) {
+            return;
+        }
+        String lockState;
+        try {
+            LenosLockBridge lock = new LenosLockBridge(requireContext());
+            lockState = lock.isSecure()
+                    ? getString(R.string.lenos_security_lock_set)
+                    : getString(R.string.lenos_security_lock_unset);
+        } catch (Throwable t) {
+            lockState = getString(R.string.lenos_security_lock_unknown);
+        }
+        preference.setSummary(getString(R.string.lenos_security_status_summary,
+                sysProp("ro.lenos.security.auto_bfu", "?"),
+                sysProp("ro.lenos.security.duress", "?"),
+                lockState));
