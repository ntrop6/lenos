+    private void configureMotionPreferences() {
+        configureMotionPreference(KEY_MOTION_ANIMATOR,
+                Settings.Global.ANIMATOR_DURATION_SCALE);
+        configureMotionPreference(KEY_MOTION_TRANSITION,
+                Settings.Global.TRANSITION_ANIMATION_SCALE);
+        configureMotionPreference(KEY_MOTION_WINDOW,
+                Settings.Global.WINDOW_ANIMATION_SCALE);
+
+        Preference reset = findPreference(KEY_MOTION_RESET);
+        if (reset != null) {
+            reset.setOnPreferenceClickListener(p -> {
+                resetMotion();
+                return true;
+            });
+        }
+    }
+
+    private void configureMotionPreference(String key, String settingKey) {
+        ListPreference preference = findPreference(key);
+        if (preference == null) {
+            return;
+        }
+        setMotionValue(preference, settingKey);
+        preference.setOnPreferenceChangeListener((p, newValue) -> {
+            float scale;
+            try {
+                scale = Float.parseFloat(String.valueOf(newValue));
+            } catch (NumberFormatException e) {
+                return false;
+            }
+            if (!applyMotion(settingKey, scale, (ListPreference) p)) {
+                return false;
+            }
+            updateListSummary((ListPreference) p);
+            return true;
+        });
+    }
+
+    private void setMotionValue(ListPreference preference, String settingKey) {
+        float current = Settings.Global.getFloat(getContentResolver(),
+                settingKey, 1.0f);
+        String value = MOTION_VALUES[0];
+        for (String candidate : MOTION_VALUES) {
+            if (Math.abs(Float.parseFloat(candidate) - current) < 0.01f) {
+                value = candidate;
+                break;
+            }
+        }
+        preference.setValue(value);
+        updateListSummary(preference);
+    }
+
+    private boolean applyMotion(String settingKey, float scale,
+            ListPreference preference) {
+        try {
+            float current = Settings.Global.getFloat(getContentResolver(),
+                    settingKey, 1.0f);
+            if (Math.abs(current - scale) < 0.01f) {
+                return true;
+            }
+            Settings.Global.putFloat(getContentResolver(), settingKey, scale);
+            toast(getString(R.string.lenos_toast_motion_set,
+                    motionLabel(settingKey), String.valueOf(scale)));
+            return true;
+        } catch (Throwable t) {
+            toast(getString(R.string.lenos_toast_motion_failed, messageOf(t)));
+            setMotionValue(preference, settingKey);
+            return false;
+        }
+    }
+
+    private void resetMotion() {
+        try {
+            Settings.Global.putFloat(getContentResolver(),
+                    Settings.Global.ANIMATOR_DURATION_SCALE, 1.0f);
+            Settings.Global.putFloat(getContentResolver(),
+                    Settings.Global.TRANSITION_ANIMATION_SCALE, 1.0f);
+            Settings.Global.putFloat(getContentResolver(),
+                    Settings.Global.WINDOW_ANIMATION_SCALE, 1.0f);
+            ListPreference animator = findPreference(KEY_MOTION_ANIMATOR);
+            ListPreference transition = findPreference(KEY_MOTION_TRANSITION);
+            ListPreference window = findPreference(KEY_MOTION_WINDOW);
+            if (animator != null) {
+                setMotionValue(animator, Settings.Global.ANIMATOR_DURATION_SCALE);
+            }
+            if (transition != null) {
+                setMotionValue(transition, Settings.Global.TRANSITION_ANIMATION_SCALE);
+            }
+            if (window != null) {
+                setMotionValue(window, Settings.Global.WINDOW_ANIMATION_SCALE);
+            }
+            toast(R.string.lenos_toast_motion_reset);
+        } catch (Throwable t) {
+            toast(getString(R.string.lenos_toast_motion_reset_failed,
+                    messageOf(t)));
+        }
+    }
+
+    private static String motionLabel(String key) {
+        if (Settings.Global.ANIMATOR_DURATION_SCALE.equals(key)) {
+            return "System animations";
+        }
+        if (Settings.Global.TRANSITION_ANIMATION_SCALE.equals(key)) {
+            return "Transition animations";
+        }
+        return "Window animations";
+    }
