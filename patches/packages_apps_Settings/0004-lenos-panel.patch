+    private void configureSecurityPreferences() {
+        ListPreference bfu = findPreference(KEY_BFU);
+        if (bfu != null) {
+            bfu.setValue(String.valueOf(Settings.Global.getInt(
+                    getContentResolver(), BFU_SETTING, BFU_DEFAULT_MS)));
+            updateListSummary(bfu);
+            bfu.setOnPreferenceChangeListener((p, newValue) -> {
+                int value;
+                try {
+                    value = Integer.parseInt(String.valueOf(newValue));
+                } catch (NumberFormatException e) {
+                    return false;
+                }
+                int current = Settings.Global.getInt(getContentResolver(),
+                        BFU_SETTING, BFU_DEFAULT_MS);
+                if (value == current) {
+                    return true;
+                }
+                try {
+                    Settings.Global.putInt(getContentResolver(), BFU_SETTING, value);
+                    toast(value == 0 ? R.string.lenos_toast_bfu_off
+                            : R.string.lenos_toast_bfu_set);
+                    updateListSummary((ListPreference) p);
+                    return true;
+                } catch (Throwable t) {
+                    toast(R.string.lenos_toast_bfu_failed);
+                    return false;
+                }
+            });
+        }
+
+        SwitchPreferenceCompat scramble = findPreference(KEY_SCRAMBLE);
+        if (scramble != null) {
+            scramble.setChecked(Settings.Secure.getInt(getContentResolver(),
+                    SCRAMBLE_SETTING, 1) != 0);
+            scramble.setOnPreferenceChangeListener((p, newValue) -> {
+                boolean enabled = (Boolean) newValue;
+                try {
+                    Settings.Secure.putInt(getContentResolver(), SCRAMBLE_SETTING,
+                            enabled ? 1 : 0);
+                    toast(enabled ? R.string.lenos_toast_scramble_on
+                            : R.string.lenos_toast_scramble_off);
+                    return true;
+                } catch (Throwable t) {
+                    toast(R.string.lenos_toast_scramble_failed);
+                    ((SwitchPreferenceCompat) p).setChecked(!enabled);
+                    return false;
+                }
+            });
+        }
+
+        Preference duress = findPreference(KEY_DURESS);
+        if (duress != null) {
+            duress.setOnPreferenceClickListener(p -> {
+                new SubSettingLauncher(requireContext())
+                        .setDestination(LenosDuressFragment.class.getName())
+                        .setTitleRes(R.string.lenos_duress_screen_title)
+                        .setSourceMetricsCategory(getMetricsCategory())
+                        .launch();
+                return true;
+            });
+        }
+    }
