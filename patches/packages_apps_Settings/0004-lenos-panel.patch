+    private boolean applyTheme(String value) {
+        try {
+            OverlayManager manager = getContext().getSystemService(OverlayManager.class);
+            if (manager == null) {
+                throw new IllegalStateException("OverlayManager unavailable");
+            }
+            int selected = indexOf(THEME_VALUES, value);
+            if (selected < 0) {
+                selected = 0;
+            }
+            int pack = selected - 1;
+
+            Set<String> systemUiInstalled = installedPackages(manager, SYSTEMUI_PACKAGE);
+            Set<String> frameworkInstalled = installedPackages(manager, "android");
+            for (int i = 0; i < THEME_PACKAGES.length; i++) {
+                if (systemUiInstalled.contains(THEME_PACKAGES[i])) {
+                    manager.setEnabled(THEME_PACKAGES[i], i == pack,
+                            Process.myUserHandle());
+                }
+            }
+            boolean frameworkFailure = false;
+            for (int i = 0; i < FRAMEWORK_PACKAGES.length; i++) {
+                if (!frameworkInstalled.contains(FRAMEWORK_PACKAGES[i])) {
+                    frameworkFailure |= i == pack;
+                    continue;
+                }
+                try {
+                    manager.setEnabled(FRAMEWORK_PACKAGES[i], i == pack,
+                            Process.myUserHandle());
+                } catch (Throwable t) {
+                    frameworkFailure = true;
+                }
+            }
+            boolean seedApplied = applyMonetSeed(pack);
+            if (frameworkFailure && !seedApplied) {
+                toast(R.string.lenos_toast_theme_partial);
+            } else {
+                toast(pack < 0 ? R.string.lenos_toast_theme_stock
+                        : R.string.lenos_toast_theme_applied);
+            }
+            return true;
+        } catch (Throwable t) {
+            toast(getString(R.string.lenos_toast_theme_failed, messageOf(t)));
+            return false;
+        }
+    }
