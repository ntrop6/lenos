diff --git a/src/com/android/settings/lenos/LenosDuressFragment.java b/src/com/android/settings/lenos/LenosDuressFragment.java
new file mode 100644
index 0000000..5fab620
--- /dev/null
+++ b/src/com/android/settings/lenos/LenosDuressFragment.java
@@ -0,0 +1,301 @@
+/*
+ * SPDX-FileCopyrightText: 2026 lenOS
+ * SPDX-License-Identifier: Apache-2.0
+ */
+package com.android.settings.lenos;
+
+import android.app.AlertDialog;
+import android.graphics.Color;
+import android.os.Bundle;
+import android.util.Log;
+import android.util.TypedValue;
+import android.view.LayoutInflater;
+import android.view.View;
+import android.view.ViewGroup;
+import android.view.WindowManager;
+import android.widget.EditText;
+import android.widget.TextView;
+import android.widget.Toast;
+
+import androidx.annotation.NonNull;
+import androidx.annotation.Nullable;
+import androidx.fragment.app.Fragment;
+
+import com.android.settings.R;
+
+/**
+ * Duress credential UI, now a Settings sub-screen instead of a separate APK.
+ *
+ * <p>The controls are backed by the lenOS framework patch in
+ * LockSettingsService. Everything stays in memory: the fields are not
+ * preferences, are excluded from autofill and are not saved across rotation.
+ * The window is marked secure while this screen is visible.</p>
+ */
+public class LenosDuressFragment extends Fragment {
+    private static final String TAG = "LenosDuress";
+
+    private LenosLockBridge mLock;
+    private TextView mStatus;
+    private EditText mOwnerPin;
+    private EditText mDuressPin;
+    private EditText mDuressPinConfirm;
+    private EditText mDuressPassword;
+    private EditText mDuressPasswordConfirm;
+
+    @Nullable
+    @Override
+    public View onCreateView(@NonNull LayoutInflater inflater,
+            @Nullable ViewGroup container, @Nullable Bundle savedInstanceState) {
+        return inflater.inflate(R.layout.lenos_duress_fragment, container, false);
+    }
+
+    @Override
+    public void onViewCreated(@NonNull View view, @Nullable Bundle savedInstanceState) {
+        super.onViewCreated(view, savedInstanceState);
+        mStatus = view.findViewById(R.id.lenos_duress_status);
+        mOwnerPin = view.findViewById(R.id.lenos_owner_pin);
+        mDuressPin = view.findViewById(R.id.lenos_duress_pin);
+        mDuressPinConfirm = view.findViewById(R.id.lenos_duress_pin_confirm);
+        mDuressPassword = view.findViewById(R.id.lenos_duress_password);
+        mDuressPasswordConfirm = view.findViewById(R.id.lenos_duress_password_confirm);
+
+        try {
+            mLock = new LenosLockBridge(requireContext());
+        } catch (Throwable t) {
+            Log.w(TAG, "LockBridge unavailable", t);
+            mLock = null;
+        }
+
+        view.findViewById(R.id.lenos_duress_check).setOnClickListener(
+                v -> checkDuress());
+        view.findViewById(R.id.lenos_duress_save).setOnClickListener(
+                v -> confirmSaveDuress());
+        view.findViewById(R.id.lenos_duress_delete).setOnClickListener(
+                v -> confirmDeleteDuress());
+        setStatus(R.string.lenos_duress_check_hint, false);
+    }
+
+    @Override
+    public void onResume() {
+        super.onResume();
+        if (getActivity() != null) {
+            getActivity().setTitle(R.string.lenos_duress_screen_title);
+            getActivity().getWindow().addFlags(
+                    WindowManager.LayoutParams.FLAG_SECURE);
+        }
+    }
+
+    @Override
+    public void onPause() {
+        if (getActivity() != null) {
+            getActivity().getWindow().clearFlags(
+                    WindowManager.LayoutParams.FLAG_SECURE);
+        }
+        super.onPause();
+    }
+
+    @Override
+    public void onDestroyView() {
+        clearFields();
+        mStatus = null;
+        mOwnerPin = null;
+        mDuressPin = null;
+        mDuressPinConfirm = null;
+        mDuressPassword = null;
+        mDuressPasswordConfirm = null;
+        super.onDestroyView();
+    }
+
+    private void checkDuress() {
+        Object owner = null;
+        try {
+            requireLock();
+            owner = ownerCredential();
+            boolean has = mLock.hasDuress(owner);
+            setStatus(has ? R.string.lenos_duress_present
+                    : R.string.lenos_duress_none, !has);
+        } catch (Exception e) {
+            setStatus(friendly(e), true);
+        } finally {
+            zero(owner);
+            clearOwnerPin();
+        }
+    }
+
+    private void confirmSaveDuress() {
+        String pin = textOf(mDuressPin);
+        String pinConfirm = textOf(mDuressPinConfirm);
+        String password = textOf(mDuressPassword);
+        String passwordConfirm = textOf(mDuressPasswordConfirm);
+        if (pin.length() < 4 || !pin.equals(pinConfirm)) {
+            toast(R.string.lenos_duress_pin_invalid);
+            return;
+        }
+        if (password.length() < 4 || !password.equals(passwordConfirm)) {
+            toast(R.string.lenos_duress_password_invalid);
+            return;
+        }
+        if (pin.equals(textOf(mOwnerPin))) {
+            toast(R.string.lenos_duress_pin_same);
+            return;
+        }
+        new AlertDialog.Builder(requireContext())
+                .setTitle(R.string.lenos_duress_dialog_title)
+                .setMessage(R.string.lenos_duress_warning)
+                .setNegativeButton(R.string.lenos_duress_dialog_cancel, null)
+                .setPositiveButton(R.string.lenos_duress_dialog_proceed,
+                        (dialog, which) -> saveDuress(pin, password))
+                .show();
+    }
+
+    private void saveDuress(String pin, String password) {
+        Object owner = null;
+        Object duressPin = null;
+        Object duressPassword = null;
+        try {
+            requireLock();
+            owner = ownerCredential();
+            duressPin = mLock.createPin(pin);
+            duressPassword = mLock.createPassword(password);
+            mLock.setDuress(owner, duressPin, duressPassword);
+            setStatus(R.string.lenos_duress_saved, false);
+            clearFields();
+            toast(R.string.lenos_duress_saved);
+        } catch (Exception e) {
+            setStatus(friendly(e), true);
+            toast(R.string.lenos_duress_save_failed);
+        } finally {
+            zero(owner);
+            zero(duressPin);
+            zero(duressPassword);
+        }
+    }
+
+    private void confirmDeleteDuress() {
+        new AlertDialog.Builder(requireContext())
+                .setTitle(R.string.lenos_duress_delete_dialog_title)
+                .setMessage(R.string.lenos_duress_delete_dialog_message)
+                .setNegativeButton(R.string.lenos_duress_dialog_cancel, null)
+                .setPositiveButton(R.string.lenos_duress_delete_confirm,
+                        (dialog, which) -> deleteDuress())
+                .show();
+    }
+
+    private void deleteDuress() {
+        Object owner = null;
+        try {
+            requireLock();
+            owner = ownerCredential();
+            mLock.deleteDuress(owner);
+            setStatus(R.string.lenos_duress_deleted, false);
+            toast(R.string.lenos_duress_deleted);
+        } catch (Exception e) {
+            setStatus(friendly(e), true);
+        } finally {
+            zero(owner);
+            clearOwnerPin();
+        }
+    }
+
+    private void requireLock() throws Exception {
+        if (mLock != null) {
+            return;
+        }
+        try {
+            mLock = new LenosLockBridge(requireContext());
+        } catch (Throwable t) {
+            throw new IllegalStateException("Lock APIs blocked: "
+                    + t.getClass().getSimpleName() + ": " + t.getMessage());
+        }
+    }
+
+    private Object ownerCredential() throws Exception {
+        String pin = textOf(mOwnerPin);
+        if (pin.isEmpty()) {
+            throw new IllegalArgumentException(
+                    getString(R.string.lenos_duress_enter_owner));
+        }
+        return mLock.createPin(pin);
+    }
+
+    private void zero(Object credential) {
+        if (mLock != null) {
+            mLock.zeroize(credential);
+        }
+    }
+
+    private String friendly(Exception e) {
+        String message = e.getMessage();
+        if (message == null || message.isEmpty()) {
+            message = e.getClass().getSimpleName();
+        }
+        if (message.contains("owner credential")) {
+            return getString(R.string.lenos_duress_wrong_owner);
+        }
+        if (message.contains("factory reset protection")
+                || message.contains("FRP")) {
+            return getString(R.string.lenos_duress_frp);
+        }
+        if (isPrivilegeError(e)) {
+            return getString(R.string.lenos_duress_privilege);
+        }
+        return message;
+    }
+
+    private static boolean isPrivilegeError(Exception e) {
+        String message = String.valueOf(e.getMessage()) + " "
+                + e.getClass().getName();
+        if (message.contains("owner credential")) {
+            return false;
+        }
+        return message.contains("ACCESS_KEYGUARD")
+                || message.contains("LockSettingsWrite")
+                || message.contains("Permission Denial")
+                || e instanceof SecurityException;
+    }
+
+    private void setStatus(int messageRes, boolean error) {
+        if (mStatus == null) {
+            return;
+        }
+        mStatus.setText(messageRes);
+        mStatus.setTextColor(error ? resolveColor(android.R.attr.colorError,
+                Color.RED) : resolveColor(android.R.attr.colorAccent,
+                Color.GRAY));
+    }
+
+    private int resolveColor(int attribute, int fallback) {
+        TypedValue value = new TypedValue();
+        if (requireContext().getTheme().resolveAttribute(attribute, value, true)) {
+            return value.data;
+        }
+        return fallback;
+    }
+
+    private void clearFields() {
+        setText(mOwnerPin, "");
+        setText(mDuressPin, "");
+        setText(mDuressPinConfirm, "");
+        setText(mDuressPassword, "");
+        setText(mDuressPasswordConfirm, "");
+    }
+
+    private void clearOwnerPin() {
+        setText(mOwnerPin, "");
+    }
+
+    private static void setText(EditText field, String value) {
+        if (field != null) {
+            field.setText(value);
+        }
+    }
+
+    private static String textOf(EditText field) {
+        return field == null || field.getText() == null
+                ? "" : field.getText().toString();
+    }
+
+    private void toast(int messageRes) {
+        Toast.makeText(requireContext(), messageRes, Toast.LENGTH_LONG).show();
+    }
+}
diff --git a/src/com/android/settings/lenos/LenosLockBridge.java b/src/com/android/settings/lenos/LenosLockBridge.java
new file mode 100644
index 0000000..b61d24d
--- /dev/null
+++ b/src/com/android/settings/lenos/LenosLockBridge.java
@@ -0,0 +1,90 @@
+/*
+ * SPDX-FileCopyrightText: 2026 lenOS
+ * SPDX-License-Identifier: Apache-2.0
+ */
+package com.android.settings.lenos;
+
+import android.content.Context;
+
+import java.lang.reflect.Constructor;
+import java.lang.reflect.Method;
+
+/**
+ * Reflection wrapper over the hidden {@code LockPatternUtils} and
+ * {@code LockscreenCredential} APIs used by the duress backend.
+ *
+ * <p>The backend itself is a framework patch
+ * ({@code frameworks/base/0005-lenos-duress-credentials}) that adds
+ * {@code setDuressCredentials}, {@code hasDuressCredentials} and
+ * {@code deleteDuressCredentials}. Keeping the calls reflective means this
+ * Settings screen does not need a compile-time link to those hidden classes,
+ * and fails with a readable error when the backend is not present.</p>
+ */
+final class LenosLockBridge {
+    private static final String LOCK_PATTERN_UTILS =
+            "com.android.internal.widget.LockPatternUtils";
+    private static final String LOCKSCREEN_CREDENTIAL =
+            "com.android.internal.widget.LockscreenCredential";
+
+    private final Object mLockPatternUtils;
+
+    LenosLockBridge(Context context) throws Exception {
+        Class<?> clazz = Class.forName(LOCK_PATTERN_UTILS);
+        Constructor<?> constructor = clazz.getConstructor(Context.class);
+        mLockPatternUtils = constructor.newInstance(context);
+    }
+
+    boolean isSecure() {
+        try {
+            Method method = mLockPatternUtils.getClass().getMethod("isSecure", int.class);
+            return (Boolean) method.invoke(mLockPatternUtils, 0);
+        } catch (Exception e) {
+            return false;
+        }
+    }
+
+    Object createPin(String pin) throws Exception {
+        Class<?> clazz = Class.forName(LOCKSCREEN_CREDENTIAL);
+        Method method = clazz.getMethod("createPin", CharSequence.class);
+        return method.invoke(null, pin);
+    }
+
+    Object createPassword(String password) throws Exception {
+        Class<?> clazz = Class.forName(LOCKSCREEN_CREDENTIAL);
+        Method method = clazz.getMethod("createPassword", CharSequence.class);
+        return method.invoke(null, password);
+    }
+
+    void setDuress(Object owner, Object pin, Object password) throws Exception {
+        Class<?> credential = Class.forName(LOCKSCREEN_CREDENTIAL);
+        Method method = mLockPatternUtils.getClass().getMethod(
+                "setDuressCredentials", credential, credential, credential);
+        method.invoke(mLockPatternUtils, owner, pin, password);
+    }
+
+    boolean hasDuress(Object owner) throws Exception {
+        Class<?> credential = Class.forName(LOCKSCREEN_CREDENTIAL);
+        Method method = mLockPatternUtils.getClass().getMethod(
+                "hasDuressCredentials", credential);
+        return (Boolean) method.invoke(mLockPatternUtils, owner);
+    }
+
+    void deleteDuress(Object owner) throws Exception {
+        Class<?> credential = Class.forName(LOCKSCREEN_CREDENTIAL);
+        Method method = mLockPatternUtils.getClass().getMethod(
+                "deleteDuressCredentials", credential);
+        method.invoke(mLockPatternUtils, owner);
+    }
+
+    void zeroize(Object credential) {
+        if (credential == null) {
+            return;
+        }
+        try {
+            Method method = credential.getClass().getMethod("zeroize");
+            method.invoke(credential);
+        } catch (Exception ignored) {
+            // Best effort: the credential is already unreachable.
+        }
+    }
+}
