+
+package com.android.settings.ext;
+
+import android.content.Context;
+import android.text.format.DateUtils;
+
+import com.android.settings.R;
+
+/**
+ * lenOS: the timeout choices for the GrapheneOS radio auto-off timers,
+ * mirroring GrapheneOS's AutoOffSetting (0 = never, plus 15 s..8 h).
+ * The setting values are milliseconds, matching ExtSettings.WIFI_AUTO_OFF
+ * and BLUETOOTH_AUTO_OFF.
+ */
+public class AutoOffSetting {
+
+    private static final int[] VALUES_MILLIS = {
+            0,
+            15_000, 30_000,
+            60_000, 2 * 60_000, 5 * 60_000, 10 * 60_000, 30 * 60_000,
+            60 * 60_000, 2 * 60 * 60_000, 4 * 60 * 60_000, 8 * 60 * 60_000,
+    };
+
+    public static CharSequence[] getEntries(Context ctx) {
+        CharSequence[] entries = new CharSequence[VALUES_MILLIS.length];
+        for (int i = 0; i < VALUES_MILLIS.length; i++) {
+            int value = VALUES_MILLIS[i];
+            entries[i] = value == 0 ? ctx.getString(R.string.auto_off_never)
+                    : DateUtils.formatDuration(value);
+        }
+        return entries;
+    }
+
+    public static CharSequence[] getValues() {
+        CharSequence[] values = new CharSequence[VALUES_MILLIS.length];
+        for (int i = 0; i < VALUES_MILLIS.length; i++) {
+            values[i] = Integer.toString(VALUES_MILLIS[i]);
+        }
+        return values;
+    }
+}
