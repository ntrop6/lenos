+
+package com.android.settings.ext;
+
+import android.content.Context;
+import android.ext.settings.CrossProfileClipboardAccessSettings;
+
+import androidx.preference.ListPreference;
+import androidx.preference.PreferenceScreen;
+
+import com.android.settings.R;
+import com.android.settings.core.BasePreferenceController;
+
+/**
+ * lenOS: per-user cross-profile clipboard policy, ported from GrapheneOS
+ * (PsCrossProfileClipboardAccessPrefCtrl, adapted to a plain ListPreference).
+ */
+public class CrossProfileClipboardPrefController extends BasePreferenceController {
+    private static final String KEY = "privacy_cross_profile_clipboard";
+
+    private ListPreference preference;
+
+    public CrossProfileClipboardPrefController(Context ctx) {
+        super(ctx, KEY);
+    }
+
+    @Override
+    public int getAvailabilityStatus() {
+        return AVAILABLE;
+    }
+
+    @Override
+    public void displayPreference(PreferenceScreen screen) {
+        super.displayPreference(screen);
+        preference = screen.findPreference(KEY);
+        if (preference == null) {
+            return;
+        }
+        preference.setPersistent(false);
+        preference.setEntries(new CharSequence[] {
+                mContext.getString(R.string.cross_profile_clipboard_access_allow_defaults_title),
+                mContext.getString(
+                        R.string.cross_profile_clipboard_access_allow_import_defaults_title),
+                mContext.getString(
+                        R.string.cross_profile_clipboard_access_allow_export_defaults_title),
+                mContext.getString(R.string.cross_profile_clipboard_access_disallow_title),
+        });
+        preference.setEntryValues(new CharSequence[] {
+                Integer.toString(CrossProfileClipboardAccessSettings.FOLLOW_DEFAULT),
+                Integer.toString(CrossProfileClipboardAccessSettings.ALLOW_IMPORT_DEFAULTS_ONLY),
+                Integer.toString(CrossProfileClipboardAccessSettings.ALLOW_EXPORT_DEFAULTS_ONLY),
+                Integer.toString(CrossProfileClipboardAccessSettings.BLOCK),
+        });
+        preference.setOnPreferenceChangeListener((p, newValue) -> {
+            final int value;
+            try {
+                value = Integer.parseInt((String) newValue);
+            } catch (NumberFormatException e) {
+                return false;
+            }
+            return CrossProfileClipboardAccessSettings.CROSS_PROFILE_CLIPBOARD_ACCESS_SETTINGS
+                    .put(mContext, value);
+        });
+        updateState();
+    }
+
+    private void updateState() {
+        if (preference == null) {
+            return;
+        }
+        final int value = CrossProfileClipboardAccessSettings
+                .CROSS_PROFILE_CLIPBOARD_ACCESS_SETTINGS.get(mContext);
+        preference.setValue(Integer.toString(value));
+        preference.setSummary(getSummaryForValue(value));
+    }
+
+    private CharSequence getSummaryForValue(int value) {
+        switch (value) {
+            case CrossProfileClipboardAccessSettings.ALLOW_IMPORT_DEFAULTS_ONLY:
+                return mContext.getString(
+                        R.string.cross_profile_clipboard_access_allow_import_defaults_summary);
+            case CrossProfileClipboardAccessSettings.ALLOW_EXPORT_DEFAULTS_ONLY:
+                return mContext.getString(
+                        R.string.cross_profile_clipboard_access_allow_export_defaults_summary);
+            case CrossProfileClipboardAccessSettings.BLOCK:
+                return mContext.getString(
+                        R.string.cross_profile_clipboard_access_disallow_summary);
+            default:
+                return mContext.getString(
+                        R.string.cross_profile_clipboard_access_allow_defaults_summary);
+        }
+    }
+}
