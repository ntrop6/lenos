+ * distributed under the License is distributed on an "AS IS" BASIS,
+ * WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+ * See the License for the specific language governing permissions and
+ * limitations under the License.
+ */
+
+package com.android.settings.ext;
+
+import android.content.Context;
+import android.ext.settings.IntSetting;
+
+import androidx.preference.ListPreference;
+import androidx.preference.PreferenceScreen;
+
+import com.android.settings.core.BasePreferenceController;
+
+/**
+ * lenOS: small list-style control for an {@link IntSetting}.
+ *
+ * <p>GrapheneOS drives integer settings through {@code IntSettingPrefController}
+ * with a {@code RadioButtonPickerFragment2} sub-screen. lenOS uses a plain
+ * {@link ListPreference} dialog with the same setting keys and values
+ * (documented UI substitution, like the radio auto-off timers).</p>
+ */
+public abstract class IntSettingListPrefController extends BasePreferenceController {
+
+    private final IntSetting setting;
+    private final String requiredFeature;
+
+    private int[] values;
+    private int[] labels;
+    private int[] summaries;
+
+    private ListPreference preference;
+
+    protected IntSettingListPrefController(Context ctx, String key, IntSetting setting,
+            String requiredFeature) {
+        super(ctx, key);
+        this.setting = setting;
+        this.requiredFeature = requiredFeature;
+    }
+
+    /**
+     * @param values    setting values, in display order
+     * @param labels    string resources shown in the dialog, parallel to values
+     * @param summaries optional summary resources, parallel to values; use 0
+     *                  to reuse the label as the summary
+     */
+    protected final void setChoices(int[] values, int[] labels, int[] summaries) {
+        this.values = values;
+        this.labels = labels;
+        this.summaries = summaries;
+    }
+
+    @Override
+    public int getAvailabilityStatus() {
+        if (requiredFeature != null
+                && !mContext.getPackageManager().hasSystemFeature(requiredFeature)) {
+            return UNSUPPORTED_ON_DEVICE;
+        }
+        // Device-wide (Settings.Global) setting: only the system user can edit it.
+        return ExtSettingControllerHelper.getGlobalSettingAvailability(mContext);
+    }
+
+    @Override
+    public void displayPreference(PreferenceScreen screen) {
+        super.displayPreference(screen);
+        preference = screen.findPreference(getPreferenceKey());
+        if (preference == null) {
+            return;
+        }
+        final CharSequence[] entries = new CharSequence[values.length];
+        final CharSequence[] entryValues = new CharSequence[values.length];
+        for (int i = 0; i < values.length; i++) {
+            entries[i] = mContext.getText(labels[i]);
+            entryValues[i] = Integer.toString(values[i]);
+        }
+        preference.setPersistent(false);
+        preference.setEntries(entries);
+        preference.setEntryValues(entryValues);
+        preference.setOnPreferenceChangeListener((p, newValue) -> {
+            final int value;
+            try {
+                value = Integer.parseInt((String) newValue);
+            } catch (NumberFormatException e) {
+                return false;
+            }
+            if (!setting.put(mContext, value)) {
+                return false;
+            }
+            updateState();
+            return true;
+        });
+        updateState();
+    }
+
+    private void updateState() {
+        if (preference == null) {
+            return;
+        }
+        final int value = setting.get(mContext);
+        int index = 0;
+        for (int i = 0; i < values.length; i++) {
+            if (values[i] == value) {
+                index = i;
+                break;
+            }
+        }
+        final CharSequence summary;
+        if (summaries != null && summaries[index] != 0) {
+            summary = mContext.getText(summaries[index]);
+        } else {
+            summary = mContext.getText(labels[index]);
+        }
+        preference.setSummary(summary);
+        preference.setValue(Integer.toString(value));
+    }
+}
