<?xml version="1.0" encoding="utf-8"?>
<!--
     SPDX-FileCopyrightText: 2026 lenOS
     SPDX-License-Identifier: Apache-2.0

     Local-only customization app. It deliberately requests no network,
     location, account or telemetry permission. OverlayManager needs
     CHANGE_OVERLAY_PACKAGES; motion presets write Settings.Global and theme
     seeding writes the secure theme setting.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="org.lenos.parts"
    android:versionCode="1"
    android:versionName="1.0.0">

    <uses-permission android:name="android.permission.CHANGE_OVERLAY_PACKAGES" />
    <uses-permission android:name="android.permission.WRITE_SECURE_SETTINGS" />
    <!--
         Signature-scoped launcher grid control. LenosParts and Launcher3 are
         both platform-signed, so this is granted without BIND_WALLPAPER and
         without adding a privileged-permission allowlist entry.
    -->
    <uses-permission android:name="com.android.launcher3.permission.GRID_CONTROL" />

    <application
        android:label="@string/app_name"
        android:icon="@drawable/ic_lenos_parts"
        android:allowBackup="false"
        android:supportsRtl="true"
        android:theme="@android:style/Theme.DeviceDefault.NoActionBar">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
