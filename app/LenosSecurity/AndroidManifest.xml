<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="org.lenos.security"
    android:versionCode="4"
    android:versionName="1.0.0">

    <!-- No uses-sdk: platform apps follow the platform's own target SDK. A
         pinned targetSdkVersion would opt the app out of Android 17 behavior
         and compatibility hardening. -->

    <!-- The platform signature satisfies both signature|privileged grants.
         The app writes Settings and LockSettingsService directly; it has no
         root/su fallback and needs no telephony permissions. -->
    <uses-permission android:name="android.permission.ACCESS_KEYGUARD_SECURE_STORAGE" />
    <uses-permission android:name="android.permission.WRITE_SECURE_SETTINGS" />

    <application
        android:name=".CrashApp"
        android:label="@string/app_name"
        android:icon="@drawable/logo"
        android:allowBackup="false"
        android:supportsRtl="true"
        android:theme="@android:style/Theme.DeviceDefault.NoActionBar">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:excludeFromRecents="false"
            android:windowSoftInputMode="adjustResize"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <intent-filter>
                <action android:name="org.lenos.security.SETTINGS" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>
    </application>
</manifest>
