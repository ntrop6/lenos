<?xml version="1.0" encoding="utf-8"?>
<!--
     SPDX-FileCopyrightText: 2026 lenOS
     SPDX-License-Identifier: Apache-2.0

     Mutable (not static) overlay: The lenOS Settings panel enables exactly one theme pack
     through OverlayManager. SystemUI does not declare an overlayable subset,
     so no targetName is needed.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="org.lenos.theme.ember.systemui">
    <overlay
        android:targetPackage="com.android.systemui"
        android:isStatic="false"
        android:priority="100" />
    <application android:hasCode="false" />
</manifest>
