//
// Mutable SystemUI overlay for the Ember local theme pack. It is installed on
// the product partition and enabled only by the lenOS Settings panel; there is no network
// component and no code.
//
runtime_resource_overlay {
    name: "LenosThemeEmberSystemUI",
    product_specific: true,
    certificate: "platform",
}
