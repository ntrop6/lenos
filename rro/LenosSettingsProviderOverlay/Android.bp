//
// Static runtime overlay for the Settings provider
// (com.android.providers.settings). Delivers the lenOS first-boot defaults
// that DatabaseHelper#loadGlobalSettings reads from resources; the stock
// values stay untouched in frameworks/base.
//

runtime_resource_overlay {
    name: "LenosSettingsProviderOverlay",
    product_specific: true,
}
