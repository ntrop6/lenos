     lenOS hardened first-boot defaults, read by
     com.android.providers.settings.DatabaseHelper#loadGlobalSettings when the
     settings database is created. Only values that differ from stock
     LineageOS are listed; every value stays a regular user setting afterwards
     (the provider only seeds, never rewrites).

     The def_lenos_* resources are defined (with stock values) in
     frameworks/base/packages/SettingsProvider/res/values/defaults.xml.
-->
<resources>
    <!-- Radios and scanning ========================================== -->
    <!-- Bluetooth off until the user turns it on. -->
    <bool name="def_bluetooth_on">false</bool>
    <!-- No wakeup scanning / "open networks available" notifications while
         Wi-Fi is off. -->
    <bool name="def_wifi_wakeup_enabled">false</bool>
    <bool name="def_networks_available_notification_on">false</bool>
    <!-- Location off until the user enables it (Settings keeps the choice). -->
    <integer name="def_location_mode">0</integer>
    <!-- USB mass storage off. -->
    <bool name="def_usb_mass_storage_enabled">false</bool>
    <!-- No QR-scanner shortcut on the secure lock screen. -->
    <bool name="def_lock_screen_show_qr_code_scanner">false</bool>

    <!-- Connectivity privacy ========================================= -->
    <!-- Strict DNS-over-TLS to Quad9 (Settings.Global.PRIVATE_DNS_MODE/
         PRIVATE_DNS_SPECIFIER). No local-network plaintext DNS by default. -->
    <!-- Wi-Fi privacy defaults (per-connection MAC randomization, DHCP hostname
         off) are carried by the Wi-Fi module patch, not by this overlay. -->
    <string name="def_lenos_private_dns_mode" translatable="false">hostname</string>
    <string name="def_lenos_private_dns_specifier" translatable="false">dns.quad9.net</string>
    <!-- NTP: community pool instead of the Google time service. -->
    <string name="def_lenos_ntp_server" translatable="false">pool.ntp.org</string>
    <!-- Captive portal: prompt (0 = ignore, 1 = prompt, 2 = avoid). -->
    <integer name="def_lenos_captive_portal_mode">1</integer>

    <!-- Lock and data protection ====================================== -->
    <!-- The auto-reboot-to-BFU timer is owned by init (see
         system/core/init/property_service.cpp) and configured through
         Settings.Global."settings_reboot_after_timeout" (18 hours by
         default, see android.ext.settings.ExtSettings). No def_* seed: the
         default is the ExtSettings code default, as in GrapheneOS. -->
</resources>
