//
// Static runtime overlay for framework-res (package "android").
// Mirrors the shape of the device overlays in
// device/nothing/asteroids/rro_overlays (isStatic manifest, product
// partition) so it is enabled at boot like they are.
//

runtime_resource_overlay {
    name: "LenosFrameworksOverlay",
    product_specific: true,
}
