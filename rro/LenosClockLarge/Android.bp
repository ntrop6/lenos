//
// Mutable SystemUI overlay for the clock text-size choice.
// Installed on the product partition and toggled by the lenOS Settings panel.
//
runtime_resource_overlay {
    name: "LenosClockLarge",
    product_specific: true,
    certificate: "platform",
}
