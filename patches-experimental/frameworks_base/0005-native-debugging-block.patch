+package android.app;
+
+import android.content.Context;
+import android.content.pm.ApplicationInfo;
+import android.os.Process;
+import android.os.UserHandle;
+import android.provider.Settings;
+import android.util.Slog;
+
+/**
+ * Experimental lenOS native-debugging block.
+ *
+ * <p>This is a deliberately small, global approximation of GrapheneOS's per-app
+ * {@code BLOCK_NATIVE_DEBUGGING} policy. It clears the process dumpable bit for newly started
+ * non-system, non-debuggable, non-profileable app processes when the secure setting is enabled.
+ * The kernel then refuses same-UID ptrace, /proc/pid/mem and similar accesses unless the caller
+ * has CAP_SYS_PTRACE (for example, root or the crash dumper).</p>
+ *
+ * <p>It is not the full GrapheneOS feature: there is no per-app allow/deny state, no
+ * {@code GosPackageState}, no SELinux per-package domain, and no denial UI. Running processes are
+ * not changed; reboot or force-stop an app after changing the setting. System apps, debuggable
+ * apps and profileable apps are exempt so normal development and profiling continue to work.
+ * The setting is off by default and this path is not included in the 1.0 series.</p>
+ */
+final class NativeDebuggingBlock {
+    private static final String TAG = "NativeDebuggingBlock";
+
+    private NativeDebuggingBlock() {
+    }
+
+    static void apply(ApplicationInfo appInfo, Context context) {
+        if (appInfo == null || context == null) {
+            return;
+        }
+        if (appInfo.isSystemApp() || appInfo.isUpdatedSystemApp() || appInfo.isDebuggable()
+                || appInfo.isProfileable()) {
+            return;
+        }
+
+        final int enabled;
+        try {
+            enabled = Settings.Secure.getIntForUser(context.getContentResolver(),
+                    Settings.Secure.BLOCK_NATIVE_DEBUGGING, 0, UserHandle.myUserId());
+        } catch (Exception e) {
+            Slog.w(TAG, "Unable to read native-debugging policy", e);
+            return;
+        }
+        if (enabled != 1) {
+            return;
+        }
+
+        try {
+            Process.setDumpable(false);
+        } catch (Exception e) {
+            // A denied prctl is logged rather than crashing the app process. The setting is a
+            // hardening layer, not a replacement for SELinux or verified boot.
+            Slog.w(TAG, "Unable to clear process dumpable bit", e);
+        }
+    }
+}
