+ * WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+ * See the License for the specific language governing permissions and
+ * limitations under the License.
+ */
+
+package com.android.server.usb;
+
+import android.app.KeyguardManager;
+import android.content.Context;
+import android.hardware.usb.UsbOperationInternal;
+import android.hardware.usb.UsbPort;
+import android.hardware.usb.UsbPortSecurity;
+import android.os.UserHandle;
+import android.util.Slog;
+
+import java.util.concurrent.atomic.AtomicInteger;
+
+/**
+ * Applies the lenOS USB data-line policy using the standard USB HAL
+ * {@code enableUsbData} operation.
+ *
+ * <p>This intentionally does not depend on a vendor-specific sysfs node. If
+ * the HAL does not implement the operation, the calls fail and the device
+ * keeps its existing behaviour; the feature is therefore explicitly
+ * experimental until the asteroid USB HAL has been validated.</p>
+ */
+final class UsbPortSecurityController {
+    private static final String TAG = "UsbPortSecurity";
+
+    private final UsbPortManager mPortManager;
+    private final KeyguardManager mKeyguardManager;
+    private final AtomicInteger mOperationId = new AtomicInteger();
+
+    private volatile boolean mBlockingData;
+    private boolean mApplied;
+    private boolean mUnlockedSinceBoot;
+
+    UsbPortSecurityController(Context context, UsbPortManager portManager) {
+        mPortManager = portManager;
+        mKeyguardManager = context.getSystemService(KeyguardManager.class);
+    }
+
+    void systemReady() {
+        // If there is no secure keyguard, the first-unlock condition is already
+        // satisfied. With a secure keyguard this stays false until onScreenLockChange(false).
+        mUnlockedSinceBoot = mKeyguardManager == null || !mKeyguardManager.isKeyguardLocked();
+        applyMode();
+    }
+
+    boolean isBlockingData() {
+        return mBlockingData;
+    }
+
+    @UsbPortSecurity.PortSecurityMode
+    int getMode() {
+        return UsbPortSecurity.getMode();
+    }
+
+    /**
+     * Changes the policy. The caller is responsible for checking that the
+     * device is unlocked and that the caller holds MANAGE_USB.
+     */
+    synchronized void updateSetting(int newValue) {
+        if (!UsbPortSecurity.isValidMode(newValue)) {
+            throw new IllegalArgumentException("invalid USB port security mode: " + newValue);
+        }
+        if (mKeyguardManager != null && mKeyguardManager.isKeyguardLocked()) {
+            throw new IllegalStateException("device must be unlocked to change USB port security");
+        }
+        UsbPortSecurity.setMode(newValue);
+        mUnlockedSinceBoot = true;
+        applyModeLocked();
+    }
+
+    synchronized void onScreenLockChange(boolean locked) {
+        if (!locked) {
+            mUnlockedSinceBoot = true;
+        }
+        applyModeLocked();
+    }
+
+    synchronized void onUserUnlocked(int userId) {
+        if (userId == UserHandle.USER_SYSTEM) {
+            mUnlockedSinceBoot = true;
+            applyModeLocked();
+        }
+    }
+
+    private void applyMode() {
+        synchronized (this) {
+            applyModeLocked();
+        }
+    }
+
+    private void applyModeLocked() {
+        final int mode = UsbPortSecurity.getMode();
+        final boolean locked = mKeyguardManager != null && mKeyguardManager.isKeyguardLocked();
+
+        final boolean block;
+        switch (mode) {
+            case UsbPortSecurity.MODE_ALL_PORTS_DISABLED:
+            case UsbPortSecurity.MODE_CHARGING_ONLY:
+                block = true;
+                break;
+            case UsbPortSecurity.MODE_CHARGING_ONLY_WHEN_LOCKED:
+                block = locked;
+                break;
+            case UsbPortSecurity.MODE_CHARGING_ONLY_WHEN_LOCKED_AFU:
+                block = !mUnlockedSinceBoot || locked;
+                break;
+            case UsbPortSecurity.MODE_ALL_PORTS_ENABLED:
+                block = false;
+                break;
+            default:
+                throw new IllegalStateException("invalid USB port security mode: " + mode);
+        }
+
+        if (mApplied && block == mBlockingData) {
+            return;
+        }
+        mBlockingData = block;
+        mApplied = true;
+
+        final UsbPort[] ports = mPortManager.getPorts();
+        Slog.i(TAG, "applying USB port security mode " + mode + ", blocking data=" + block
+                + ", ports=" + ports.length);
+        for (UsbPort port : ports) {
+            enablePortData(port, !block);
+        }
+    }
+
+    private void enablePortData(UsbPort port, boolean enable) {
+        final int operationId = mOperationId.incrementAndGet();
+        final UsbOperationInternal callback =
+                new UsbOperationInternal(operationId, port.getId());
+        try {
+            mPortManager.enableUsbData(port.getId(), enable, operationId, callback, null);
+        } catch (RuntimeException e) {
+            Slog.w(TAG, "unable to " + (enable ? "enable" : "disable")
+                    + " USB data on port " + port.getId(), e);
+        }
+    }
+}
