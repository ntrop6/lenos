+package android.hardware.usb;
+
+import android.annotation.IntDef;
+import android.os.Build;
+import android.os.SystemProperties;
+
+import java.lang.annotation.Retention;
+import java.lang.annotation.RetentionPolicy;
+
+/**
+ * Controls whether USB data lines are available while the device is locked.
+ *
+ * <p>This is a lenOS experimental implementation of the USB-C port control
+ * feature. It uses the standard Android per-port {@code enableUsbData} HAL
+ * operation; devices whose USB HAL does not implement that operation will
+ * simply keep their existing data behaviour.
+ *
+ * @hide
+ */
+public final class UsbPortSecurity {
+    /** Block USB data on all ports; charging is still possible. */
+    public static final int MODE_ALL_PORTS_DISABLED = 0;
+    /** Block USB data on all ports; charging is still possible. */
+    public static final int MODE_CHARGING_ONLY = 1;
+    /** Block USB data while the keyguard is showing. */
+    public static final int MODE_CHARGING_ONLY_WHEN_LOCKED = 2;
+    /** Block USB data until the first unlock, then only while locked. */
+    public static final int MODE_CHARGING_ONLY_WHEN_LOCKED_AFU = 3;
+    /** Leave USB data enabled. */
+    public static final int MODE_ALL_PORTS_ENABLED = 4;
+
+    /**
+     * Persistent property shared with USB HAL implementations that enforce the
+     * same policy in firmware. Keep the GrapheneOS key verbatim.
+     */
+    public static final String MODE_SETTING = "persist.security.usb_mode";
+
+    /** Debuggable builds keep adb available for bring-up. */
+    public static final int DEFAULT_MODE = Build.IS_DEBUGGABLE
+            ? MODE_ALL_PORTS_ENABLED
+            : MODE_CHARGING_ONLY_WHEN_LOCKED;
+
+    @IntDef(prefix = {"MODE_"}, value = {
+            MODE_ALL_PORTS_DISABLED,
+            MODE_CHARGING_ONLY,
+            MODE_CHARGING_ONLY_WHEN_LOCKED,
+            MODE_CHARGING_ONLY_WHEN_LOCKED_AFU,
+            MODE_ALL_PORTS_ENABLED,
+    })
+    @Retention(RetentionPolicy.SOURCE)
+    public @interface PortSecurityMode {}
+
+    private UsbPortSecurity() {
+    }
+
+    /** Returns the configured mode, or the build-appropriate default. */
+    public static @PortSecurityMode int getMode() {
+        final int mode = SystemProperties.getInt(MODE_SETTING, DEFAULT_MODE);
+        return isValidMode(mode) ? mode : DEFAULT_MODE;
+    }
+
+    public static boolean isValidMode(int mode) {
+        return mode >= MODE_ALL_PORTS_DISABLED && mode <= MODE_ALL_PORTS_ENABLED;
+    }
+
+    /** Persists a mode. Callers must validate that the device is unlocked. */
+    public static void setMode(@PortSecurityMode int mode) {
+        if (!isValidMode(mode)) {
+            throw new IllegalArgumentException("invalid USB port security mode: " + mode);
+        }
+        SystemProperties.set(MODE_SETTING, Integer.toString(mode));
+    }
+}
