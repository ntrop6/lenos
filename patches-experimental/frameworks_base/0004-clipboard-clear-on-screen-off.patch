+    /**
+     * Wipes the clipboard for every user who opted into the lenOS
+     * clear-on-screen-off policy. Protected broadcasts are delivered to the
+     * system context even when the device is locked, so the data is gone
+     * before the display turns fully off.
+     */
+    private void clearClipboardsOnScreenOff() {
+        final long ident = Binder.clearCallingIdentity();
+        try {
+            synchronized (mLock) {
+                for (int i = mClipboards.numMaps() - 1; i >= 0; i--) {
+                    final int userId = mClipboards.keyAt(i);
+                    final int enabled = Settings.Secure.getIntForUser(
+                            getContext().getContentResolver(),
+                            Settings.Secure.CLIPBOARD_CLEAR_ON_SCREEN_OFF, 0, userId);
+                    if (enabled == 0) {
+                        continue;
+                    }
+                    for (int j = mClipboards.numElementsForKeyAt(i) - 1; j >= 0; j--) {
+                        final Clipboard clipboard = mClipboards.valueAt(i, j);
+                        if (clipboard.primaryClip == null) {
+                            continue;
+                        }
+                        setPrimaryClipInternalLocked(null,
+                                UserHandle.getUid(userId, android.os.Process.SYSTEM_UID),
+                                clipboard.deviceId, null);
+                    }
+                }
+            }
+        } finally {
+            Binder.restoreCallingIdentity(ident);
+        }
+    }
